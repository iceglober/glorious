# Node / TS
# No trailing slash: with one, git matches a directory and not a symlink, and
# a worktree that links node_modules to a shared install gets it committed by
# `git add -A`. On a clean runner that link is broken, and bun install reports
# `ENOENT: could not open the "node_modules" directory`.
node_modules
dist/
/docs-site/generated/
packages/glorious-coding-agent/docs/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Env
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo

# Bun
.bun/

# coder runtime state written into target repos
.coder/proposals/
.coder/fixtures/
.coder/*.jsonl

.lab/
run.log

# eval harness run artifacts (traj dumps + result rows)
core/eval/results/
core/eval/traj/
eval/**/results.json

# Project-User settings stay local; Project config.json stays tracked.
/.glrs/config.local.json
# Keep the retired path ignored so an existing local file cannot be committed.
/.glorious/config.local.json

# local agent event log
coding-agent.db*
