# Azure model configuration
AZURE_FOUNDRY_API_KEY=
# AZURE_API_KEY=
# AZURE_OPENAI_API_KEY=
AZURE_RESOURCE_NAME=
ACTIVEGRAPH_MODEL=gpt-4o-mini

# Optional SQLite event-log path
ACTIVEGRAPH_DB=coding-agent.db
# Maximum characters printed for each command result
ACTIVEGRAPH_MAX_OUTPUT=4000
# Follow-up rounds the reviewer may add after the initial plan (0 disables them)
ACTIVEGRAPH_MAX_ROUNDS=2
# Earlier goals from this directory shown to the planner (0 disables memory)
ACTIVEGRAPH_HISTORY=3
# Limits enforced on every command: wall clock, and bytes it may output
ACTIVEGRAPH_COMMAND_TIMEOUT_MS=120000
ACTIVEGRAPH_MAX_OUTPUT_BYTES=1000000
