{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./api/core.ts",
    "./api/coding-agent.ts",
    "./api/providers.ts"
  ],
  "entryPointStrategy": "resolve",
  "alwaysCreateEntryPointModule": true,
  "tsconfig": "./tsconfig.json",
  "out": "./dist",
  "plugin": [
    "./theme/index.ts",
    "@boneskull/typedoc-plugin-mermaid"
  ],
  "theme": "glrs",
  "router": "structure-dir",
  "customCss": "./theme/glrs.css",
  "name": "glrs",
  "includeVersion": false,
  "readme": "none",
  "projectDocuments": [
    "../docs/published/quickstart.md",
    "../docs/published/install.md",
    "../docs/published/architecture.md",
    "../docs/published/features.md",
    "../docs/published/extensions.md",
    "../docs/published/lifecycle.md",
    "../docs/published/skills.md",
    "../docs/published/commands.md",
    "../docs/published/tools.md",
    "../docs/published/providers.md",
    "../docs/published/models.md",
    "../docs/published/configuration.md",
    "../docs/published/cli.md",
    "../docs/published/troubleshooting.md",
    "../docs/published/philosophy.md",
    "../docs/published/glossary.md"
  ],
  "sortEntryPoints": false,
  "searchInComments": true,
  "searchInDocuments": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeReferences": true,
  "githubPages": false,
  "hideGenerator": true,
  "markdownLinkExternal": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "markdown",
    "tsx",
    "typescript",
    "yaml"
  ],
  "ignoredHighlightLanguages": ["mermaid"],
  "mermaidSource": "local",
  "headings": {
    "readme": true,
    "document": false
  },
  "locales": {
    "en": {
      "kind_module": "API",
      "kind_plural_module": "API",
      "kind_type_alias": " "
    }
  }
}
