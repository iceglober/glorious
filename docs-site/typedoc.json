{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./api/core.ts",
    "./api/coding-agent.ts",
    "./api/providers.ts"
  ],
  "entryPointStrategy": "resolve",
  "alwaysCreateEntryPointModule": true,
  "tsconfig": "./tsconfig.json",
  "out": "./dist",
  "plugin": ["./theme/index.ts"],
  "theme": "glrs",
  "router": "structure",
  "customCss": "./theme/glrs.css",
  "name": "glrs",
  "includeVersion": false,
  "readme": "none",
  "projectDocuments": ["../docs/published/index.md"],
  "sortEntryPoints": false,
  "searchInComments": true,
  "searchInDocuments": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeReferences": true,
  "githubPages": false,
  "hideGenerator": true,
  "markdownLinkExternal": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "markdown",
    "tsx",
    "typescript",
    "yaml"
  ],
  "ignoredHighlightLanguages": ["mermaid"],
  "headings": {
    "readme": true,
    "document": false
  },
  "locales": {
    "en": {
      "kind_module": "API",
      "kind_plural_module": "API"
    }
  }
}
