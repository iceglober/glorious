{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./api.ts"],
  "entryPointStrategy": "resolve",
  "alwaysCreateEntryPointModule": false,
  "tsconfig": "./tsconfig.json",
  "out": "./dist",
  "plugin": ["./theme/index.ts"],
  "theme": "glrs",
  "customCss": "./theme/glrs.css",
  "customJs": "./theme/glrs.js",
  "name": "glorious",
  "includeVersion": false,
  "readme": "none",
  "projectDocuments": ["../docs/published/index.md"],
  "searchInComments": true,
  "searchInDocuments": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeReferences": true,
  "githubPages": false,
  "hideGenerator": true,
  "markdownLinkExternal": true,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "markdown",
    "tsx",
    "typescript",
    "yaml"
  ],
  "ignoredHighlightLanguages": ["mermaid"],
  "headings": {
    "readme": true,
    "document": false
  }
}
