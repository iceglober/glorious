{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "Docs site for the @glrs-dev ecosystem. Published to https://glrs.dev.",
  "type": "module",
  "scripts": {
    "generate": "bun scripts/generate-api.ts",
    "dev": "bun run generate && vite",
    "edit": "bun install && bun run generate && bun scripts/edit.ts",
    "build": "bun run generate && vite build",
    "preview": "vite preview",
    "pretypecheck": "bun run generate",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests yet'",
    "lint": "echo 'no linter configured yet'"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
