{
  "name": "@glrs-dev/glorious",
  "version": "1.0.0-next.37",
  "private": false,
  "description": "glorious: a simple terminal coding agent — a barebones chat TUI over an agent with bash/read/write/edit/grep/glob tools. The sole product lives in v2/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iceglober/glorious.git"
  },
  "bugs": "https://github.com/iceglober/glorious/issues",
  "homepage": "https://glrs.dev",
  "files": [
    "bin",
    "v2",
    "!v2/**/*.test.ts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "next"
  },
  "bin": {
    "glorious": "bin/glorious"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun v2/index.ts",
    "glorious": "bun v2/index.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:next": "bun publish --access public --tag next"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.2.24",
    "@types/node": "^24.0.15",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.50",
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/azure": "^4.0.11",
    "@ai-sdk/cerebras": "^3.0.27",
    "@ai-sdk/cohere": "^4.0.25",
    "@ai-sdk/deepseek": "^3.0.26",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/google-vertex": "^5.0.47",
    "@ai-sdk/groq": "^4.0.26",
    "@ai-sdk/mistral": "^4.0.27",
    "@ai-sdk/openai": "4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.27",
    "@ai-sdk/perplexity": "^4.0.27",
    "@ai-sdk/togetherai": "^3.0.28",
    "@ai-sdk/xai": "^4.0.33",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentui/core": "0.4.5",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.22",
    "zod": "^4.4.3"
  }
}
