{
  "name": "@glrs-dev/glorious",
  "version": "0.1.0-next.2",
  "private": false,
  "description": "glorious: a simple terminal coding agent — a basic chat TUI over an agent with bash/read/edit/search tools. The sole product lives in core/; this file carries the root Bun entrypoints.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iceglober/glorious.git"
  },
  "bugs": "https://github.com/iceglober/glorious/issues",
  "homepage": "https://glrs.dev",
  "files": [
    "bin",
    "core",
    "README.md",
    "LICENSE",
    "!core/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "next"
  },
  "bin": {
    "glorious": "bin/glorious"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun core/agent-loop.ts",
    "glorious": "bun core/agent-loop.ts",
    "test": "bun test core docs activegraph",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "docs": "bun docs/generate.ts",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:next": "bun publish --access public --tag next"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.2.24",
    "@types/node": "^24.0.15",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@ai-sdk/azure": "^4.0.11",
    "@opentui/core": "0.4.5",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.22",
    "bash-tool": "^1.3.17",
    "cmd-ts": "^0.15.0",
    "zod": "^4.4.3"
  }
}
